# PostgreSQL connection settings
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/your_database
JDBC_DATABASE_USERNAME=your_database_user
JDBC_DATABASE_PASSWORD=your_database_password

# Default seed passwords for enterprise role accounts
# These are used ONLY on first-time database seeding.
# Change these after initial deployment. Passwords are never stored in source code.
FINOPS_ADMIN_PASSWORD=your_admin_password_here
FINOPS_MANAGER_PASSWORD=your_manager_password_here
FINOPS_OFFICER_PASSWORD=your_officer_password_here
FINOPS_RM_PASSWORD=your_rm_password_here
FINOPS_CUSTOMER_DEMO_PASSWORD=your_customer_demo_password_here
